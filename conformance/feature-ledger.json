    },
    {
      "id": "unknown-syntax",
      "strict": true,
      "description": "The source contains syntax that the GPIF audit does not recognize."
    },
    {
      "id": "unsupported-feature",
      "strict": true,
      "description": "The parser recognizes the source content but cannot represent it in Song."
    },
    {
      "id": "lossy-projection",
      "strict": true,
      "description": "The parser maps the source content to a less precise Song value."
    },
    {
      "id": "deliberate-default",
      "strict": false,
      "description": "The parser applies a documented default when the source omits a value."
    },
    {
      "id": "deliberate-ignore",
      "strict": false,
      "description": "The parser intentionally excludes source metadata that is outside the Song contract."
    }
  ],
