{
  "schemaVersion": 1,
  "oracle": "@coderline/alphatab@1.8.4",
  "features": [
    {
      "id": "score-core",
      "formats": ["gp3", "gp4", "gp5", "gp6", "gp7", "gp8"],
      "upstreamParser": ["ScoreLoader", "Gp3To5Importer", "GpxImporter", "GpifParser"],
      "upstreamModel": ["Score", "Track"],
      "upstreamTests": ["checkMultiTrackLayoutConfiguration", "checkColors"],
      "goDestination": ["Song", "Track", "MeasureHeader"],
      "fixtures": ["testdata/gp*/score-info.*", "testdata/gp*/colors.*"],
      "semanticAssertions": ["metadata", "track identity", "repeat structure"],
      "status": "partial",
      "reason": "The full corpus parses, while richer metadata and loss reporting remain tracked by issues 12 and 13.",
      "issues": [12, 13]
    },
    {
      "id": "rhythm",
      "formats": ["gp3", "gp4", "gp5", "gp6", "gp7", "gp8"],
      "upstreamParser": ["Gp3To5Importer.readBeat", "GpifParser._parseRhythm"],
      "upstreamModel": ["MasterBar", "Beat", "Duration", "TupletGroup"],
      "upstreamTests": ["checkNotes", "checkTimeSignatures", "checkTuplets"],
      "goDestination": ["MeasureHeader.TimeSignature", "Beat.Duration", "Beat.Status"],
      "fixtures": ["testdata/gp5/tuplets.gp5", "testdata/gp7/time-signatures.gp"],
      "semanticAssertions": ["duration denominator", "duration ticks", "dots", "tuplet ratio", "rest status"],
      "status": "supported",
      "reason": "Selected binary and GPIF rhythm fixtures have no unexplained AlphaTab differences.",
      "issues": []
    },
    {
      "id": "timing",
      "formats": ["gp3", "gp4", "gp5", "gp6", "gp7", "gp8"],
      "upstreamParser": ["Gp3To5Importer", "GpifParser"],
      "upstreamModel": ["MasterBar.start", "Beat.displayStart", "Beat.playbackStart"],
      "upstreamTests": ["checkNotes", "checkTuplets", "checkGrace"],
      "goDestination": ["MeasureHeader.Start", "Measure.Start", "Beat.Start"],
      "fixtures": ["testdata/gp5/tuplets.gp5", "testdata/gp7/time-signatures.gp"],
      "semanticAssertions": ["zero-normalized measure start", "zero-normalized beat start"],
      "status": "partial",
      "reason": "Binary timing is populated, but GPIF measure and beat timing is missing; see issue 9.",
      "issues": [9]
    },
    {
      "id": "staff-ownership",
      "formats": ["gp6", "gp7", "gp8"],
      "upstreamParser": ["GpifParser._parseTracks", "GpifParser._buildModel"],
      "upstreamModel": ["Track.staves", "Staff.bars", "Staff.tuning"],
      "upstreamTests": ["checkStrings", "checkMultiTrackLayoutConfiguration"],
      "goDestination": ["Track.Measures", "Track.Strings", "Measure.Clef"],
      "fixtures": ["testdata/gp7/grand-staff.gp"],
      "semanticAssertions": ["staff count", "bar count per staff", "note ownership per staff", "clef", "tuning"],
      "status": "partial",
      "reason": "The second staff and its 18 notes are missing from the Go model; see issue 4.",
      "issues": [4]
    },
    {
      "id": "grace-relationships",
      "formats": ["gp3", "gp4", "gp5", "gp6", "gp7", "gp8"],
      "upstreamParser": ["Gp3To5Importer.readGrace", "GpifParser._parseBeat"],
      "upstreamModel": ["Voice.addGraceBeat", "GraceGroup", "Note"],
      "upstreamTests": ["checkGrace"],
      "goDestination": ["NoteEffect.Graces", "GraceEffect"],
      "fixtures": ["testdata/gp5/grace.gp5", "testdata/gp5/motherload-percussion-grace.gp5"],
      "semanticAssertions": ["owning note", "ordered grace sequence", "authored source fret", "transition", "on-beat flag"],
      "status": "partial",
      "reason": "Selected authored ownership and source-fret cases agree after excluding display duration and playback pitch; complete cross-format grace coverage is tracked by issue 12.",
      "issues": [12]
    },
    {
      "id": "note-and-beat-semantics",
      "formats": ["gp3", "gp4", "gp5", "gp6", "gp7", "gp8"],
      "upstreamParser": ["Gp3To5Importer.readNote", "Gp3To5Importer.readNoteEffects", "GpifParser._parseNote"],
      "upstreamModel": ["Beat", "Note"],
      "upstreamTests": ["checkDead", "checkAccentuations", "checkHammer", "checkBend", "checkSlides", "checkVibrato", "checkTrills", "checkOtherEffects", "checkFingering"],
      "goDestination": ["Beat", "BeatEffects", "Note", "NoteEffect"],
      "fixtures": ["testdata/gp*/effects.*", "testdata/gp*/notes.*"],
      "semanticAssertions": ["note ownership", "pitch and string", "dynamics", "ties", "bends", "slides", "articulations"],
      "status": "partial",
      "reason": "The canonical contract inventories these fields; a lossless semantic model is tracked by issue 12.",
      "issues": [12]
    },
    {
      "id": "tremolo-picking",
      "formats": ["gp3", "gp4", "gp5", "gp6", "gp7", "gp8"],
      "upstreamParser": ["Gp3To5Importer.readTremoloPicking", "GpifParser._parseBeat"],
      "upstreamModel": ["Beat.tremoloPicking", "TremoloPickingEffect"],
      "upstreamTests": ["checkOtherEffects"],
      "goDestination": ["NoteEffect.TremoloPicking"],
      "fixtures": ["testdata/gp7/tremolo-picking.gp"],
      "semanticAssertions": ["marked beat path", "1/2, 1/4 and 1/8 subdivision"],
      "status": "partial",
      "reason": "All six GPIF tremolo-picking values are discarded; see issue 5.",
      "issues": [5]
    },
    {
      "id": "harmonics",
      "formats": ["gp3", "gp4", "gp5", "gp6", "gp7", "gp8"],
      "upstreamParser": ["Gp3To5Importer.readArtificialHarmonic", "GpifParser._parseNoteProperties"],
      "upstreamModel": ["Note.harmonicType", "Note.harmonicValue"],
      "upstreamTests": ["checkHarmonics"],
      "goDestination": ["HarmonicEffect.Kind", "HarmonicEffect.FretFloat"],
      "fixtures": ["testdata/gp7/harmonics.gp"],
      "semanticAssertions": ["harmonic kind", "fractional harmonic fret", "property order"],
      "status": "partial",
      "reason": "GPIF HFret values are missing on import and Go exports the nonstandard Float child; see issue 6.",
      "issues": [6]
    },
    {
      "id": "hairpins",
      "formats": ["gp6", "gp7", "gp8"],
      "upstreamParser": ["GpifParser._parseBeat"],
      "upstreamModel": ["Beat.crescendo", "CrescendoType"],
      "upstreamTests": ["checkOtherEffects"],
      "goDestination": ["BeatEffects.Hairpin"],
      "fixtures": ["testdata/gp7/notation-legend.gp"],
      "semanticAssertions": ["crescendo beat path", "decrescendo beat path"],
      "status": "partial",
      "reason": "Three Decrescendo beats are lost and GP8 output uses Diminuendo; see issue 7.",
      "issues": [7]
    },
    {
      "id": "tempo-automations",
      "formats": ["gp3", "gp4", "gp5", "gp6", "gp7", "gp8"],
      "upstreamParser": ["Gp3To5Importer.readMixTableChange", "GpifParser._parseMasterTrackAutomations"],
      "upstreamModel": ["Automation", "AutomationType.Tempo", "MasterBar.tempoAutomations"],
      "upstreamTests": ["checkOtherEffects"],
      "goDestination": ["Song.Tempo", "Song.TempoAutomations", "MixTableChange.Tempo"],
      "fixtures": ["testdata/gp7/beat-tempo-change.gp"],
      "semanticAssertions": ["bar", "ratio position", "normalized BPM", "linear interpolation"],
      "status": "partial",
      "reason": "Quarter-note reference fixtures agree, but non-quarter reference units are ignored; see issue 8.",
      "issues": [8]
    },
    {
      "id": "percussion-articulations",
      "formats": ["gp3", "gp4", "gp5", "gp6", "gp7", "gp8"],
      "upstreamParser": ["Gp3To5Importer.readNote", "GpifParser._parseNote", "GpifParser._parseInstrumentSet"],
      "upstreamModel": ["Note.percussionArticulation", "Track.percussionArticulations", "InstrumentArticulation"],
      "upstreamTests": ["checkNotes"],
      "goDestination": ["Track.PercussionTrack", "Note.Value"],
      "fixtures": ["testdata/gp5/motherload-percussion-grace.gp5", "testdata/gp7/percussion.gp"],
      "semanticAssertions": ["articulation identity", "input value", "output MIDI", "staff line and technique"],
      "status": "partial",
      "reason": "Binary drum values are exposed, but GPIF articulation identity and per-track definitions are lost; see issue 10.",
      "issues": [10]
    }
  ]
}
