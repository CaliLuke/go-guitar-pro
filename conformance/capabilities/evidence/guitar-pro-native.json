  "findings": [
    {
      "id": "sound-text",
      "status": "fixed",
      "detail": "Plain-text Sound.Name becomes empty in native save. CDATA retains all three names. No claim about other sound metadata or playback."
    },
    {
      "id": "pitched-notes",
      "status": "confirmed-defect",
      "detail": "Current export loses all 12 note occurrences in Guitar Pro. Adding both ConcertPitch and TransposedPitch retains the 12 notes; either field alone still loses them. This requires a public default-spelling contract and complete pitch-context coverage before integration."
    },
    {
      "id": "sound-position",
      "status": "confirmed-defect",
      "detail": "Original native Sound Position=1 displays tick 481. Current exported Position=0.25 displays tick 121. The position-only probe changes only the first Sound.Position to 1, keeps Linear=true, and displays tick 481. Tempo and channel-strip positions remain 0.25. Do not apply one unit conversion to every automation type."
    },
    {
      "id": "legacy-volume",
      "status": "confirmed-discrepancy",
      "detail": "Native GP3 conversion emits DSPParam_12=0.56 at position 0.25; Go emits 0.75 for raw volume 12. Native initial event 0.58 is also absent from Go channel-strip events. The complete legacy conversion needs further controls."
    },
    {
      "id": "legacy-interpolation",
      "status": "confirmed-discrepancy",
      "detail": "Native GP3 conversion uses Linear=false for zero-duration tempo, sound, volume and pan changes. Go projects Linear=true. Verify native interpolation semantics before closure."
    },
    {
      "id": "notation-ownership",
      "status": "native-observation",
      "detail": "Guitar Pro track inspector shows one notation selection for the grand-staff track, with separate staff tuning controls. The second track is independently hidden. The current export still loses notes, so this does not satisfy the full notation-ticket acceptance checklist."
    },
    {
      "id": "absent-accidental-probe",
      "status": "rejected-experiment",
      "detail": "Removing Accidental from both experimental pitch records retains notes, but native save fills an empty Accidental and preserves Step C / Octave 5 beside MIDI 61. This creates contradictory notation and numeric pitch; it is not a default-spelling solution."
    },
    {
      "id": "partial-capo-acquisition",
      "status": "missing-input",
      "detail": "Keyboard navigation reached the partial-capo numeric editor and set fret 3, but the string selector still displayed No strings capoed after accessibility, coordinate and keyboard attempts. Cancelled tuning changes. No asymmetric-string fixture or verified flag order was acquired; #115 remains open."
    }
  ],
