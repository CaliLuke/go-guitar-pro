  ],
  "acceptance": [
    "Ordinary Beat.Timer and attached GraceEffect.Timer preserve absent, derived and explicit safe-integer values at exact consumer beat addresses.",
    "Independent parsed occurrence storage supports public edits and clears; contradictory requests in one grace chord reject before export.",
    "Timed partial-match groups retain all original standalone grace beats, preventing duplicate marks or changed source note membership."
  ],
  "limits": [
    "Milliseconds must lie in 0..9007199254740991. A derived request has a nil milliseconds pointer and emits -1.",
    "No playback timer is calculated. Consumer values are read after import, before MIDI generation.",
    "Notes grouped by sequence, effective duration, effective velocity and on-beat placement must request equal timer states by value."
  ],
  "tests": [
    "TestGraceTimerPublicSource",
    "TestGraceTimerPublicInvalidAndConflictingEdits",
    "TestConformanceGraceTimers",
    "TestAlphaTabGraceTimers",
    "TestGraceTimerSourceValidationAndContexts",
    "TestGraceTimerPartialMatchRetainsSourceBeats",
    "TestGraceTimerIndependentVoiceScopes",
    "TestGraceTimerIndependentStaffScopes"
  ]
}
